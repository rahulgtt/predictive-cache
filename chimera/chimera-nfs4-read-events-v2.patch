+
+static void
+nfs4_read_events_publish_state_locked(struct nfs4_read_events *events)
+{
+    uint64_t enqueued = atomic_load_explicit(
+        &events->last_enqueued_sequence, memory_order_relaxed);
+    uint64_t synced = atomic_load_explicit(
+        &events->last_synced_sequence, memory_order_relaxed);
+    uint64_t in_flight = atomic_load_explicit(
+        &events->worker_in_flight, memory_order_relaxed);
+    uint64_t delivery_clean = atomic_load_explicit(
+        &events->delivery_clean, memory_order_acquire);
+
+    prometheus_gauge_set(events->last_enqueued_instance, (int64_t) enqueued);
+    prometheus_gauge_set(events->last_synced_instance, (int64_t) synced);
+    prometheus_gauge_set(events->synced_count_instance, (int64_t)
+                         atomic_load_explicit(&events->synced_count,
+                                              memory_order_relaxed));
+    prometheus_gauge_set(events->queue_depth_instance, (int64_t) events->count);
+    prometheus_gauge_set(events->worker_in_flight_instance, (int64_t) in_flight);
+    if (events->before_barrier_publish_fn) {
+        events->before_barrier_publish_fn();
+    }
+    int ready = enqueued == synced && events->count == 0 &&
+        in_flight == 0 && delivery_clean == 1;
+    prometheus_gauge_set(events->barrier_ready_instance, ready);
+    if (ready &&
+        atomic_load_explicit(&events->delivery_clean,
+                             memory_order_acquire) == 0) {
+        prometheus_gauge_set(events->barrier_ready_instance, 0);
+    }
+} /* nfs4_read_events_publish_state_locked */
+
+static void
+nfs4_read_events_invalidate_barrier(struct nfs4_read_events *events)
+{
+    atomic_store_explicit(&events->delivery_clean, 0, memory_order_release);
+    if (events->delivery_clean_instance) {
+        prometheus_gauge_set(events->delivery_clean_instance, 0);
+    }
+    if (events->barrier_ready_instance) {
+        prometheus_gauge_set(events->barrier_ready_instance, 0);
+    }
+} /* nfs4_read_events_invalidate_barrier */
+
+static void
+nfs4_read_events_note_queue_drop(struct nfs4_read_events *events)
+{
+    atomic_fetch_add_explicit(&events->dropped_queue, 1, memory_order_relaxed);
+    if (events->queue_instance) {
+        __atomic_fetch_add(&events->queue_instance->value, 1, __ATOMIC_RELAXED);
+    }
+    nfs4_read_events_invalidate_barrier(events);
+} /* nfs4_read_events_note_queue_drop */
+
+static int
+nfs4_read_events_enqueue(
+    struct nfs4_read_events             *events,
+    const struct nfs4_read_queued_event *event)
+{
+    unsigned int           tail;
+    struct timespec        timestamp;
+    struct nfs4_read_queued_event copy = *event;
+
+    if (clock_gettime(CLOCK_REALTIME, &timestamp) != 0) {
+        nfs4_read_events_note_queue_drop(events);
+        return 0;
+    }
+    copy.timestamp_ns = (uint64_t) timestamp.tv_sec * 1000000000ULL + timestamp.tv_nsec;
+    if (events->before_enqueue_lock_fn) {
+        events->before_enqueue_lock_fn(&copy.event);
+    }
+    if (pthread_mutex_trylock(&events->lock) != 0) {
+        nfs4_read_events_note_queue_drop(events);
+        return 0;
+    }
+    if (events->stopping || events->count == NFS4_READ_EVENT_QUEUE_SIZE) {
+        nfs4_read_events_note_queue_drop(events);
+        pthread_mutex_unlock(&events->lock);
+        return 0;
+    }
+    copy.sequence = atomic_fetch_add_explicit(&events->next_sequence, 1,
+                                               memory_order_relaxed);
+
+    tail                = (events->head + events->count) % NFS4_READ_EVENT_QUEUE_SIZE;
+    events->queue[tail] = copy;
+    events->count++;
+    atomic_store_explicit(&events->queue_depth, events->count,
+                          memory_order_release);
+    atomic_store_explicit(&events->last_enqueued_sequence, copy.sequence,
+                          memory_order_release);
+    nfs4_read_events_publish_state_locked(events);
+    pthread_cond_signal(&events->wake);
+    pthread_mutex_unlock(&events->lock);
+    return 1;
+} /* nfs4_read_events_enqueue */
+
+static void
+nfs4_read_events_update_metrics(struct nfs4_read_events *events)
+{
+    uint64_t encode_drops = atomic_load_explicit(&events->dropped_encode, memory_order_relaxed);
+    uint64_t log_drops   = atomic_load_explicit(&events->dropped_log, memory_order_relaxed);
+    uint64_t sink_drops  = atomic_load_explicit(&events->dropped_sink, memory_order_relaxed);
+    uint64_t rollback_drops = atomic_load_explicit(&events->dropped_rollback,
+                                                    memory_order_relaxed);
+    uint64_t rotation_drops = atomic_load_explicit(&events->dropped_rotation,
+                                                    memory_order_relaxed);
+
+    prometheus_counter_add(events->encode_instance,
+                           encode_drops - events->encode_reported);
+    prometheus_counter_add(events->log_instance,
+                           log_drops - events->log_reported);
+    prometheus_counter_add(events->sink_instance,
+                           sink_drops - events->sink_reported);
+    prometheus_counter_add(events->rollback_instance,
+                           rollback_drops - events->rollback_reported);
+    prometheus_counter_add(events->rotation_instance,
+                           rotation_drops - events->rotation_reported);
+    events->encode_reported = encode_drops;
+    events->log_reported = log_drops;
+    events->sink_reported = sink_drops;
+    events->rollback_reported = rollback_drops;
+    events->rotation_reported = rotation_drops;
+} /* nfs4_read_events_update_metrics */
+
+static void
+nfs4_read_events_hex(
+    const uint8_t *input,
+    size_t         length,
+    char          *output)
+{
+    static const char hex[] = "0123456789abcdef";
+
+    for (size_t i = 0; i < length; i++) {
+        output[i * 2]     = hex[input[i] >> 4];
+        output[i * 2 + 1] = hex[input[i] & 0x0f];
+    }
+    output[length * 2] = '\0';
+} /* nfs4_read_events_hex */
+
+static size_t
+nfs4_read_events_base64url(
+    const uint8_t *input,
+    size_t         length,
+    char          *output,
+    size_t         capacity)
+{
+    static const char alphabet[] =
+        "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_";
+    size_t in = 0, out = 0;
+
+    while (in < length) {
+        size_t   remaining = length - in;
+        size_t   encoded = remaining >= 3 ? 4 : remaining + 1;
+        uint32_t value = (uint32_t) input[in++] << 16;
+
+        if (remaining > 1) {
+            value |= (uint32_t) input[in++] << 8;
+        }
+        if (remaining > 2) {
+            value |= input[in++];
+        }
+        if (out + encoded + 1 > capacity) {
+            return 0;
+        }
+        output[out++] = alphabet[(value >> 18) & 0x3f];
+        output[out++] = alphabet[(value >> 12) & 0x3f];
+        if (remaining > 1) {
+            output[out++] = alphabet[(value >> 6) & 0x3f];
+        }
+        if (remaining > 2) {
+            output[out++] = alphabet[value & 0x3f];
+        }
+    }
+    output[out] = '\0';
+    return out;
+} /* nfs4_read_events_base64url */
+
+static const char *
+nfs4_read_events_origin_claim(
+    const char *tag,
+    size_t      length,
+    const char **trust)
+{
+    if (length != 104 ||
+        memcmp(tag, "pc1:", 4) != 0 ||
+        tag[5] != ':' || tag[38] != ':' || tag[71] != ':') {
+        *trust = "client_asserted";
+        return "unknown";
+    }
+    for (size_t i = 6; i < length; i++) {
+        if (i == 38 || i == 71) {
+            continue;
+        }
+        if (!isxdigit((unsigned char) tag[i])) {
+            *trust = "client_asserted";
+            return "unknown";
+        }
+    }
+    *trust = "client_asserted";
+    switch (tag[4]) {
+        case 'w':
+            return "warmer";
+        case 'd':
+            return "controlled_demand";
+        case 's':
+            return "synthetic";
+        default:
+            *trust = "client_asserted";
+            return "unknown";
+    }
+} /* nfs4_read_events_origin_claim */
+
+static void
+nfs4_read_events_finish(
+    struct nfs4_read_events *events,
+    uint64_t                 sequence,
+    bool                     synced)
+{
+    pthread_mutex_lock(&events->lock);
+    if (synced) {
+        atomic_fetch_add_explicit(&events->synced_count, 1,
+                                  memory_order_relaxed);
+        atomic_store_explicit(&events->last_synced_sequence, sequence,
+                              memory_order_release);
+    }
+    atomic_store_explicit(&events->worker_in_flight, 0,
+                          memory_order_release);
+    nfs4_read_events_update_metrics(events);
+    nfs4_read_events_publish_state_locked(events);
+    pthread_mutex_unlock(&events->lock);
+} /* nfs4_read_events_finish */
+
+static int
+nfs4_read_events_write_all(
+    struct nfs4_read_events *events,
+    const char              *buffer,
+    size_t                   length)
+{
+    size_t offset = 0;
+
+    while (offset < length) {
+        ssize_t written = events->write_fn(
+            events->sink_fd, buffer + offset, length - offset);
+
+        if (written > 0) {
+            offset += (size_t) written;
+            continue;
+        }
+        if (written < 0 && errno == EINTR) {
+            continue;
+        }
+        return 0;
+    }
+    return 1;
+} /* nfs4_read_events_write_all */
+
+static int
+nfs4_read_events_open_sink(struct nfs4_read_events *events)
+{
+    struct stat st;
+    int fd;
+
+    if (!events->sink_enabled || !events->sink_name[0]) {
+        return 0;
+    }
+    if (events->sink_dir_fd < 0) {
+        events->sink_dir_fd = open(
+            events->sink_directory,
+            O_RDONLY | O_DIRECTORY | O_CLOEXEC | O_NOFOLLOW);
+        if (events->sink_dir_fd < 0 ||
+            fstat(events->sink_dir_fd, &st) != 0 ||
+            !S_ISDIR(st.st_mode) ||
+            st.st_uid != geteuid()) {
+            if (events->sink_dir_fd >= 0) {
+                close(events->sink_dir_fd);
+                events->sink_dir_fd = -1;
+            }
+            return 0;
+        }
+    }
+    fd = openat(events->sink_dir_fd, events->sink_name,
+                O_WRONLY | O_CREAT | O_APPEND | O_CLOEXEC |
+                O_NOFOLLOW | O_NONBLOCK,
+                S_IRUSR | S_IWUSR);
+    if (fd < 0) {
+        return 0;
+    }
+    if (fstat(fd, &st) != 0 ||
+        !S_ISREG(st.st_mode) ||
+        st.st_uid != geteuid() ||
+        st.st_nlink != 1) {
+        close(fd);
+        return 0;
+    }
+    if (fchmod(fd, S_IRUSR | S_IWUSR) != 0) {
+        if (fd >= 0) {
+            close(fd);
+        }
+        return 0;
+    }
+    events->sink_fd = fd;
+    events->sink_bytes = st.st_size > 0 ? (uint64_t) st.st_size : 0;
+    return 1;
+} /* nfs4_read_events_open_sink */
+
+static int
+nfs4_read_events_configure_sink(
+    struct nfs4_read_events *events,
+    const char              *path)
+{
+    char        directory[256];
+    const char *name;
+    const char *slash;
+    size_t      path_len, dir_len, name_len;
+    if (!path) {
+        return 1;
+    }
+    path_len = strlen(path);
+    if (path_len == 0 || path_len >= sizeof(directory)) {
+        return 0;
+    }
+    slash = strrchr(path, '/');
+    if (!slash) {
+        memcpy(directory, ".", 2);
+        name = path;
+    } else {
+        dir_len = (size_t) (slash - path);
+        name = slash + 1;
+        if (dir_len == 0) {
+            memcpy(directory, "/", 2);
+        } else {
+            if (dir_len >= sizeof(directory)) {
+                return 0;
+            }
+            memcpy(directory, path, dir_len);
+            directory[dir_len] = '\0';
+        }
+    }
+    name_len = strlen(name);
+    if (name_len == 0 || name_len >= sizeof(events->sink_name) ||
+        strcmp(name, ".") == 0 || strcmp(name, "..") == 0) {
+        return 0;
+    }
+    memcpy(events->sink_directory, directory, strlen(directory) + 1);
+    memcpy(events->sink_name, name, name_len + 1);
+    if (snprintf(events->rotated_name, sizeof(events->rotated_name),
+                 "%s.1", name) < 0) {
+        return 0;
+    }
+    events->sink_enabled = 1;
+    return nfs4_read_events_open_sink(events);
+} /* nfs4_read_events_configure_sink */
+
+static int
+nfs4_read_events_rotate_sink(
+    struct nfs4_read_events *events)
+{
+    if (events->sink_fd < 0 ||
+        events->fdatasync_fn(events->sink_fd) != 0) {
+        return 0;
+    }
+    if (unlinkat(events->sink_dir_fd, events->rotated_name, 0) != 0 &&
+        errno != ENOENT) {
+        return 0;
+    }
+    if (events->fsync_fn(events->sink_dir_fd) != 0) {
+        return 0;
+    }
+    if (renameat(events->sink_dir_fd, events->sink_name,
+                 events->sink_dir_fd, events->rotated_name) != 0) {
+        return 0;
+    }
+    int rename_sync_rc = events->fsync_fn(events->sink_dir_fd);
+    close(events->sink_fd);
+    events->sink_fd = -1;
+    if (rename_sync_rc != 0) {
+        return 0;
+    }
+    if (!nfs4_read_events_open_sink(events)) {
+        return 0;
+    }
+    return events->fsync_fn(events->sink_dir_fd) == 0;
+} /* nfs4_read_events_rotate_sink */
+
+static int
+nfs4_read_events_write_sink(
+    struct nfs4_read_events       *events,
+    const struct nfs4_read_event  *read,
+    const struct nfs4_read_queued_event *queued,
+    const char                    *local_id,
+    const char                    *volume_id,
+    const char                    *file_id,
+    const char                    *export_name,
+    const char                    *target_fh,
+    const char                    *operation_id,
+    const char                    *client_ref,
+    const char                    *session_ref,
+    const char                    *compound_tag,
+    const char                    *tag_id,
+    const char                    *origin_claim,
+    const char                    *origin_trust)
+{
+    char line[3072];
+    int  length;
+    bool rotation_needed;
+    off_t record_start;
+    struct timespec sink_time;
+    uint64_t sink_time_ns;
+
+    if (!events->sink_enabled) {
+        return 1;
+    }
+    if (events->sink_fd < 0 && !nfs4_read_events_open_sink(events)) {
+        return 0;
+    }
+    if (clock_gettime(CLOCK_REALTIME, &sink_time) != 0) {
+        return 0;
+    }
+    sink_time_ns = (uint64_t) sink_time.tv_sec * 1000000000ULL +
+        sink_time.tv_nsec;
+    length = snprintf(
+        line, sizeof(line),
+        "{\"schema\":\"nfs4_read_v2\",\"local_id\":\"%s\","
+        "\"producer_epoch\":\"%s\",\"producer_sequence\":\"%" PRIu64 "\","
+        "\"event_time_ns\":\"%" PRIu64 "\",\"sink_time_ns\":\"%" PRIu64 "\","
+        "\"target_created_ns\":\"%" PRIu64 "\","
+        "\"volume_id\":\"%s\",\"file_id\":\"%s\",\"identity_valid\":%s,"
+        "\"export_name_b64\":\"%s\",\"export_id\":%u,"
+        "\"target_fh\":\"%s\",\"operation_id\":\"%s\","
+        "\"client_ref\":\"%s\",\"session_ref\":\"%s\","
+        "\"compound_op_index\":%" PRIu32 ",\"slot_id\":%" PRIu32 ","
+        "\"sequence_id\":%" PRIu32 ",\"compound_tag_b64\":\"%s\","
+        "\"compound_tag_original_length\":%" PRIu32 ","
+        "\"compound_tag_truncated\":%s,\"compound_tag_id\":\"%s\","
+        "\"origin_claim\":\"%s\",\"origin_trust\":\"%s\","
+        "\"requested_offset\":\"%" PRIu64 "\",\"requested_count\":%" PRIu32 ","
+        "\"returned_bytes\":%" PRIu32 ",\"nfs_status\":%" PRIu32 ","
+        "\"outcome\":\"%s\",\"eof\":%s,\"file_size_valid\":%s,"
+        "\"file_size\":",
+        local_id, events->producer_epoch, queued->sequence,
+        queued->timestamp_ns, sink_time_ns, read->target_created_ns,
+        volume_id, file_id,
+        read->identity_valid ? "true" : "false", export_name, read->export_id,
+        target_fh, operation_id, client_ref,
+        read->session_valid ? session_ref : "",
+        read->compound_op_index, read->slot_id, read->sequence_id, compound_tag,
+        read->compound_tag_original_len,
+        read->compound_tag_truncated ? "true" : "false", tag_id,
+        origin_claim, origin_trust, read->offset, read->requested,
+        read->bytes, read->status,
+        read->status == 0 ? "success" : "error",
+        read->status == 0 && read->eof ? "true" : "false",
+        read->file_size_valid ? "true" : "false");
+    if (length < 0 || (size_t) length >= sizeof(line)) {
+        return 0;
+    }
+    if (read->file_size_valid) {
+        int extra = snprintf(line + length, sizeof(line) - (size_t) length,
+                             "\"%" PRIu64 "\"}\n", read->file_size);
+        if (extra < 0 || (size_t) extra >= sizeof(line) - (size_t) length) {
+            return 0;
+        }
+        length += extra;
+    } else {
+        static const char suffix[] = "null}\n";
+        if ((size_t) length + sizeof(suffix) > sizeof(line)) {
+            return 0;
+        }
+        memcpy(line + length, suffix, sizeof(suffix));
+        length += sizeof(suffix) - 1;
+    }
+    rotation_needed = events->sink_bytes &&
+        events->sink_bytes + (uint64_t) length > events->sink_max_bytes;
+    if (rotation_needed && !nfs4_read_events_rotate_sink(events)) {
+        atomic_fetch_add_explicit(&events->dropped_rotation, 1,
+                                  memory_order_relaxed);
+        nfs4_read_events_invalidate_barrier(events);
+        return 0;
+    }
+    record_start = lseek(events->sink_fd, 0, SEEK_END);
+    if (record_start < 0 ||
+        !nfs4_read_events_write_all(events, line, (size_t) length) ||
+        events->fdatasync_fn(events->sink_fd) != 0) {
+        if (record_start >= 0) {
+            if (events->ftruncate_fn(events->sink_fd, record_start) != 0 ||
+                events->fdatasync_fn(events->sink_fd) != 0) {
+                atomic_fetch_add_explicit(&events->dropped_rollback, 1,
+                                          memory_order_relaxed);
+                nfs4_read_events_invalidate_barrier(events);
+            }
+        }
+        close(events->sink_fd);
+        events->sink_fd = -1;
+        return 0;
+    }
+    events->sink_bytes += (uint64_t) length;
+    return 1;
+} /* nfs4_read_events_write_sink */
+
+static void *
+nfs4_read_events_worker(void *arg)
+{
+    struct nfs4_read_events *events = arg;
+    struct nfs4_read_queued_event event;
+    struct timespec          deadline;
+    uuid_t                   uuid;
+    char                     id[37];
+    int                      have_event, stop;
+
+    for ( ;; ) {
+        pthread_mutex_lock(&events->lock);
+        if (!events->count && !events->stopping) {
+            clock_gettime(CLOCK_REALTIME, &deadline);
+            deadline.tv_sec++;
+            pthread_cond_timedwait(&events->wake, &events->lock, &deadline);
+        }
+        have_event = events->count != 0;
+        if (have_event) {
+            event        = events->queue[events->head];
+            events->head = (events->head + 1) % NFS4_READ_EVENT_QUEUE_SIZE;
+            events->count--;
+            atomic_store_explicit(&events->queue_depth, events->count,
+                                  memory_order_release);
+            atomic_store_explicit(&events->worker_in_flight, 1,
+                                  memory_order_release);
+            nfs4_read_events_publish_state_locked(events);
+        }
+        stop = events->stopping && !events->count && !have_event;
+        pthread_mutex_unlock(&events->lock);
+
+        nfs4_read_events_update_metrics(events);
+        if (stop) {
+            return NULL;
+        }
+        if (!have_event) {
+            continue;
+        }
+
+        uuid_generate_random(uuid);
+        uuid_unparse_lower(uuid, id);
+        const struct nfs4_read_event *read = &event.event;
+        const char *origin_trust;
+        const char *origin_claim =
+            nfs4_read_events_origin_claim(read->compound_tag,
+                                          read->compound_tag_len,
+                                          &origin_trust);
+        char file_id[65], volume_id[33], tag_id[65], operation_id[65];
+        char client_ref[65], session_ref[65];
+        char target_fh[172], export_name[87], compound_tag[343];
+        char file_size[32];
+        int  encode_ok = 1;
+
+        if (read->target_fh_len > sizeof(read->target_fh) ||
+            read->compound_tag_len > NFS4_READ_EVENT_TAG_SIZE) {
+            atomic_fetch_add_explicit(&events->dropped_encode, 1,
+                                      memory_order_relaxed);
+            nfs4_read_events_invalidate_barrier(events);
+            nfs4_read_events_finish(events, event.sequence, false);
+            continue;
+        }
+        nfs4_read_events_hex(read->file_id, sizeof(read->file_id), file_id);
+        nfs4_read_events_hex(read->volume_id, sizeof(read->volume_id), volume_id);
+        nfs4_read_events_hex(read->compound_tag_id,
+                             sizeof(read->compound_tag_id), tag_id);
+        nfs4_read_events_hex(read->operation_id,
+                             sizeof(read->operation_id), operation_id);
+        nfs4_read_events_hex(read->client_ref,
+                             sizeof(read->client_ref), client_ref);
+        nfs4_read_events_hex(read->session_ref,
+                             sizeof(read->session_ref), session_ref);
+        if (read->target_fh_len) {
+            encode_ok = nfs4_read_events_base64url(
+                read->target_fh, read->target_fh_len,
+                target_fh, sizeof(target_fh)) != 0;
+        }
+        if (encode_ok && read->compound_tag_len) {
+            encode_ok = nfs4_read_events_base64url(
+                (const uint8_t *) read->compound_tag,
+                read->compound_tag_len,
+                compound_tag, sizeof(compound_tag)) != 0;
+        }
+        if (encode_ok && read->export_name[0]) {
+            encode_ok = nfs4_read_events_base64url(
+                (const uint8_t *) read->export_name,
+                strnlen(read->export_name, sizeof(read->export_name)),
+                export_name, sizeof(export_name)) != 0;
+        }
+        if (!encode_ok) {
+            atomic_fetch_add_explicit(&events->dropped_encode, 1,
+                                      memory_order_relaxed);
+            nfs4_read_events_invalidate_barrier(events);
+            nfs4_read_events_finish(events, event.sequence, false);
+            continue;
+        }
+        if (!read->target_fh_len) {
+            target_fh[0] = '\0';
+        }
+        if (!read->compound_tag_len) {
+            compound_tag[0] = '\0';
+        }
+        if (!read->export_name[0]) {
+            export_name[0] = '\0';
+        }
+        if (read->file_size_valid) {
+            snprintf(file_size, sizeof(file_size), "%" PRIu64, read->file_size);
+        } else {
+            memcpy(file_size, "unknown", sizeof("unknown"));
+        }
+        int sink_ok = nfs4_read_events_write_sink(
+            events, read, &event, id, volume_id, file_id, export_name,
+            target_fh, operation_id, client_ref, session_ref, compound_tag,
+            tag_id, origin_claim, origin_trust);
+        if (!sink_ok) {
+            if (events->sink_enabled) {
+                atomic_fetch_add_explicit(&events->dropped_sink, 1,
+                                          memory_order_relaxed);
+                nfs4_read_events_invalidate_barrier(events);
+            }
+        }
+        nfs4_read_events_finish(events, event.sequence,
+                                sink_ok && events->sink_enabled);
+        if (!chimera_log_try_info("nfs", __FILE__, __LINE__,
+                                  "schema=nfs4_read_v2 local_id=%s"
+                                  " producer_epoch=%s producer_sequence=%" PRIu64
+                                  " event_time_ns=%" PRIu64
+                                  " target_created_ns=%" PRIu64
+                                  " volume_id=%s file_id=%s identity_valid=%s"
+                                  " export_name_b64=%s export_id=%u"
+                                  " target_fh=%s operation_id=%s"
+                                  " client_ref=%s session_ref=%s"
+                                  " compound_op_index=%" PRIu32
+                                  " slot_id=%" PRIu32
+                                  " sequence_id=%" PRIu32
+                                  " compound_tag_b64=%s"
+                                  " compound_tag_original_length=%" PRIu32
+                                  " compound_tag_truncated=%s"
+                                  " compound_tag_id=%s origin_claim=%s"
+                                  " origin_trust=%s"
+                                  " requested_offset=%" PRIu64
+                                  " requested_count=%" PRIu32
+                                  " returned_bytes=%" PRIu32
+                                  " nfs_status=%" PRIu32 " outcome=%s"
+                                  " eof=%s file_size_valid=%s file_size=%s",
+                                  id, events->producer_epoch, event.sequence,
+                                  event.timestamp_ns, read->target_created_ns,
+                                  volume_id, file_id,
+                                  read->identity_valid ? "true" : "false",
+                                  export_name, read->export_id, target_fh,
+                                  operation_id, client_ref,
+                                  read->session_valid ? session_ref : "",
+                                  read->compound_op_index, read->slot_id,
+                                  read->sequence_id, compound_tag,
+                                  read->compound_tag_original_len,
+                                  read->compound_tag_truncated ? "true" : "false",
+                                  tag_id, origin_claim,
+                                  origin_trust, read->offset, read->requested,
+                                  read->bytes, read->status,
+                                  read->status == 0 ? "success" : "error",
+                                  read->status == 0 && read->eof ? "true" : "false",
+                                  read->file_size_valid ? "true" : "false",
+                                  file_size)) {
+            atomic_fetch_add_explicit(&events->dropped_log, 1, memory_order_relaxed);
+        }
+    }
+} /* nfs4_read_events_worker */
+
+struct nfs4_read_events *
+nfs4_read_events_create(
+    struct prometheus_metrics *metrics,
+    const char                *sink_path)
+{
+    struct nfs4_read_events *events = calloc(1, sizeof(*events));
+    uuid_t                   epoch;
+    int                      rc;
+
+    chimera_nfs_abort_if(!events, "Failed to allocate NFSv4 READ event queue");
+    atomic_init(&events->next_sequence, 1);
+    atomic_init(&events->dropped_queue, 0);
+    atomic_init(&events->dropped_encode, 0);
+    atomic_init(&events->dropped_log, 0);
+    atomic_init(&events->dropped_sink, 0);
+    atomic_init(&events->dropped_rollback, 0);
+    atomic_init(&events->dropped_rotation, 0);
+    atomic_init(&events->delivery_clean, 1);
+    atomic_init(&events->last_enqueued_sequence, 0);
+    atomic_init(&events->last_synced_sequence, 0);
+    atomic_init(&events->synced_count, 0);
+    atomic_init(&events->queue_depth, 0);
+    atomic_init(&events->worker_in_flight, 0);
+    events->sink_fd = -1;
+    events->sink_dir_fd = -1;
+    events->sink_max_bytes = NFS4_READ_EVENT_SINK_MAX_BYTES;
+    events->write_fn = write;
+    events->fdatasync_fn = fdatasync;
+    events->ftruncate_fn = ftruncate;
+    events->fsync_fn = fsync;
+    if (!nfs4_read_events_configure_sink(events, sink_path)) {
+        atomic_fetch_add_explicit(&events->dropped_sink, 1,
+                                  memory_order_relaxed);
+        nfs4_read_events_invalidate_barrier(events);
+    }
+    uuid_generate_random(epoch);
+    uuid_unparse_lower(epoch, events->producer_epoch);
+    events->metrics = metrics;
+    events->drops   = prometheus_metrics_create_counter(
+        metrics, "chimera_nfs4_read_events_dropped",
+        "NFSv4 READ decision events dropped by stage");
+    chimera_nfs_abort_if(!events->drops, "Failed to create READ event drop metric");
+    events->queue_series = prometheus_counter_create_series(
+        events->drops, (const char *[]) { "stage" }, (const char *[]) { "queue" }, 1);
+    events->log_series = prometheus_counter_create_series(
+        events->drops, (const char *[]) { "stage" }, (const char *[]) { "log" }, 1);
+    events->encode_series = prometheus_counter_create_series(
+        events->drops, (const char *[]) { "stage" }, (const char *[]) { "encode" }, 1);
+    events->sink_series = prometheus_counter_create_series(
+        events->drops, (const char *[]) { "stage" }, (const char *[]) { "sink" }, 1);
+    events->rollback_series = prometheus_counter_create_series(
+        events->drops, (const char *[]) { "stage" }, (const char *[]) { "rollback" }, 1);
+    events->rotation_series = prometheus_counter_create_series(
+        events->drops, (const char *[]) { "stage" }, (const char *[]) { "rotation" }, 1);
+    chimera_nfs_abort_if(!events->queue_series || !events->encode_series ||
+                         !events->log_series ||
+                         !events->sink_series || !events->rollback_series ||
+                         !events->rotation_series,
+                         "Failed to create READ event drop metric series");
+    events->queue_instance = prometheus_counter_series_create_instance(events->queue_series);
+    events->encode_instance =
+        prometheus_counter_series_create_instance(events->encode_series);
+    events->log_instance   = prometheus_counter_series_create_instance(events->log_series);
+    events->sink_instance =
+        prometheus_counter_series_create_instance(events->sink_series);
+    events->rollback_instance =
+        prometheus_counter_series_create_instance(events->rollback_series);
+    events->rotation_instance =
+        prometheus_counter_series_create_instance(events->rotation_series);
+    chimera_nfs_abort_if(!events->queue_instance || !events->encode_instance ||
+                         !events->log_instance ||
+                         !events->sink_instance || !events->rollback_instance ||
+                         !events->rotation_instance,
+                         "Failed to create READ event drop metric instances");
+    events->state_gauge = prometheus_metrics_create_gauge(
+        metrics, "chimera_nfs4_read_event_state",
+        "NFSv4 READ event delivery state");
+    chimera_nfs_abort_if(!events->state_gauge,
+                         "Failed to create READ event state gauge");
+    events->producer_info_gauge = prometheus_metrics_create_gauge(
+        metrics, "chimera_nfs4_read_event_producer_info",
+        "NFSv4 READ event producer lifetime identity");
+    chimera_nfs_abort_if(!events->producer_info_gauge,
+                         "Failed to create READ event producer info gauge");
+    events->producer_info_series = prometheus_gauge_create_series(
+        events->producer_info_gauge,
+        (const char *[]) { "producer_epoch" },
+        (const char *[]) { events->producer_epoch }, 1);
+    chimera_nfs_abort_if(!events->producer_info_series,
+                         "Failed to create READ event producer info series");
+    events->producer_info_instance =
+        prometheus_gauge_series_create_instance(events->producer_info_series);
+    chimera_nfs_abort_if(!events->producer_info_instance,
+                         "Failed to create READ event producer info instance");
+    prometheus_gauge_set(events->producer_info_instance, 1);
+    events->last_enqueued_series = prometheus_gauge_create_series(
+        events->state_gauge, (const char *[]) { "state" },
+        (const char *[]) { "last_enqueued_sequence" }, 1);
+    events->last_synced_series = prometheus_gauge_create_series(
+        events->state_gauge, (const char *[]) { "state" },
+        (const char *[]) { "last_synced_sequence" }, 1);
+    events->synced_count_series = prometheus_gauge_create_series(
+        events->state_gauge, (const char *[]) { "state" },
+        (const char *[]) { "synced_count" }, 1);
+    events->queue_depth_series = prometheus_gauge_create_series(
+        events->state_gauge, (const char *[]) { "state" },
+        (const char *[]) { "queue_depth" }, 1);
+    events->worker_in_flight_series = prometheus_gauge_create_series(
+        events->state_gauge, (const char *[]) { "state" },
+        (const char *[]) { "worker_in_flight" }, 1);
+    events->barrier_ready_series = prometheus_gauge_create_series(
+        events->state_gauge, (const char *[]) { "state" },
+        (const char *[]) { "barrier_ready" }, 1);
+    events->delivery_clean_series = prometheus_gauge_create_series(
+        events->state_gauge, (const char *[]) { "state" },
+        (const char *[]) { "delivery_clean" }, 1);
+    chimera_nfs_abort_if(!events->last_enqueued_series ||
+                         !events->last_synced_series ||
+                         !events->synced_count_series ||
+                         !events->queue_depth_series ||
+                         !events->worker_in_flight_series ||
+                         !events->barrier_ready_series ||
+                         !events->delivery_clean_series,
+                         "Failed to create READ event state series");
+    events->last_enqueued_instance =
+        prometheus_gauge_series_create_instance(events->last_enqueued_series);
+    events->last_synced_instance =
+        prometheus_gauge_series_create_instance(events->last_synced_series);
+    events->synced_count_instance =
+        prometheus_gauge_series_create_instance(events->synced_count_series);
+    events->queue_depth_instance =
+        prometheus_gauge_series_create_instance(events->queue_depth_series);
+    events->worker_in_flight_instance =
+        prometheus_gauge_series_create_instance(
+            events->worker_in_flight_series);
+    events->barrier_ready_instance =
+        prometheus_gauge_series_create_instance(events->barrier_ready_series);
+    events->delivery_clean_instance =
+        prometheus_gauge_series_create_instance(events->delivery_clean_series);
+    chimera_nfs_abort_if(!events->last_enqueued_instance ||
+                         !events->last_synced_instance ||
+                         !events->synced_count_instance ||
+                         !events->queue_depth_instance ||
+                         !events->worker_in_flight_instance ||
+                         !events->barrier_ready_instance ||
+                         !events->delivery_clean_instance,
+                         "Failed to create READ event state instances");
+    prometheus_gauge_set(events->delivery_clean_instance,
+                         atomic_load_explicit(&events->delivery_clean,
+                                              memory_order_acquire));
+    nfs4_read_events_publish_state_locked(events);
+    rc = pthread_mutex_init(&events->lock, NULL);
+    chimera_nfs_abort_if(rc, "Failed to initialize READ event mutex: %d", rc);
+    rc = pthread_cond_init(&events->wake, NULL);
+    chimera_nfs_abort_if(rc, "Failed to initialize READ event condition: %d", rc);
+    rc = pthread_create(&events->worker, NULL, nfs4_read_events_worker, events);
+    chimera_nfs_abort_if(rc, "Failed to start READ event worker: %d", rc);
+    return events;
+} /* nfs4_read_events_create */
+
+void
+nfs4_read_events_destroy(struct nfs4_read_events *events)
+{
+    if (!events) {
+        return;
+    }
+    pthread_mutex_lock(&events->lock);
+    events->stopping = 1;
+    pthread_cond_signal(&events->wake);
+    pthread_mutex_unlock(&events->lock);
+    pthread_join(events->worker, NULL);
+    if (events->sink_fd >= 0) {
+        events->fdatasync_fn(events->sink_fd);
+        close(events->sink_fd);
+    }
+    if (events->sink_dir_fd >= 0) {
+        close(events->sink_dir_fd);
+    }
+    pthread_cond_destroy(&events->wake);
+    pthread_mutex_destroy(&events->lock);
+    prometheus_counter_series_destroy_instance(events->queue_series, events->queue_instance);
+    prometheus_counter_series_destroy_instance(events->encode_series,
+                                                events->encode_instance);
+    prometheus_counter_series_destroy_instance(events->log_series, events->log_instance);
+    prometheus_counter_series_destroy_instance(events->sink_series,
+                                                events->sink_instance);
+    prometheus_counter_series_destroy_instance(events->rollback_series,
+                                                events->rollback_instance);
+    prometheus_counter_series_destroy_instance(events->rotation_series,
+                                                events->rotation_instance);
+    prometheus_counter_destroy_series(events->drops, events->queue_series);
+    prometheus_counter_destroy_series(events->drops, events->encode_series);
+    prometheus_counter_destroy_series(events->drops, events->log_series);
+    prometheus_counter_destroy_series(events->drops, events->sink_series);
+    prometheus_counter_destroy_series(events->drops, events->rollback_series);
+    prometheus_counter_destroy_series(events->drops, events->rotation_series);
+    prometheus_counter_destroy(events->metrics, events->drops);
+    prometheus_gauge_series_destroy_instance(
+        events->last_enqueued_series, events->last_enqueued_instance);
+    prometheus_gauge_series_destroy_instance(
+        events->last_synced_series, events->last_synced_instance);
+    prometheus_gauge_series_destroy_instance(
+        events->synced_count_series, events->synced_count_instance);
+    prometheus_gauge_series_destroy_instance(
+        events->queue_depth_series, events->queue_depth_instance);
+    prometheus_gauge_series_destroy_instance(
+        events->worker_in_flight_series, events->worker_in_flight_instance);
+    prometheus_gauge_series_destroy_instance(
+        events->barrier_ready_series, events->barrier_ready_instance);
+    prometheus_gauge_series_destroy_instance(
+        events->delivery_clean_series, events->delivery_clean_instance);
+    prometheus_gauge_destroy_series(events->state_gauge,
+                                    events->last_enqueued_series);
+    prometheus_gauge_destroy_series(events->state_gauge,
+                                    events->last_synced_series);
+    prometheus_gauge_destroy_series(events->state_gauge,
+                                    events->synced_count_series);
+    prometheus_gauge_destroy_series(events->state_gauge,
+                                    events->queue_depth_series);
+    prometheus_gauge_destroy_series(events->state_gauge,
+                                    events->worker_in_flight_series);
+    prometheus_gauge_destroy_series(events->state_gauge,
+                                    events->barrier_ready_series);
+    prometheus_gauge_destroy_series(events->state_gauge,
+                                    events->delivery_clean_series);
+    prometheus_gauge_destroy(events->metrics, events->state_gauge);
+    prometheus_gauge_series_destroy_instance(
+        events->producer_info_series, events->producer_info_instance);
+    prometheus_gauge_destroy_series(events->producer_info_gauge,
+                                    events->producer_info_series);
+    prometheus_gauge_destroy(events->metrics, events->producer_info_gauge);
+    free(events);
+} /* nfs4_read_events_destroy */
+
+int
+nfs4_read_events_digest(
+    const void *data,
+    size_t      length,
+    uint8_t     digest[NFS4_READ_EVENT_DIGEST_SIZE])
+{
+    size_t digest_length = NFS4_READ_EVENT_DIGEST_SIZE;
+
+    return EVP_Q_digest(NULL, "SHA256", NULL, data, length,
+                        digest, &digest_length) == 1 &&
+           digest_length == NFS4_READ_EVENT_DIGEST_SIZE;
+} /* nfs4_read_events_digest */
+
+static void
+nfs4_read_events_put_be32(
+    uint8_t  output[4],
+    uint32_t value)
+{
+    output[0] = (uint8_t) (value >> 24);
+    output[1] = (uint8_t) (value >> 16);
+    output[2] = (uint8_t) (value >> 8);
+    output[3] = (uint8_t) value;
+} /* nfs4_read_events_put_be32 */
+
+int
+nfs4_read_events_file_id(
+    const uint8_t volume_id[NFS4_READ_EVENT_MOUNT_ID_SIZE],
+    const uint8_t *inner_fh,
+    uint16_t       inner_fh_len,
+    uint8_t        digest[NFS4_READ_EVENT_DIGEST_SIZE])
+{
+    static const char domain[] = "chimera-read-v2";
+    uint8_t input[sizeof(domain) + NFS4_READ_EVENT_MOUNT_ID_SIZE + 2 +
+                  NFS4_READ_EVENT_TARGET_FH_SIZE];
+    size_t  offset = 0;
+
+    if (inner_fh_len > NFS4_READ_EVENT_TARGET_FH_SIZE) {
+        return 0;
+    }
+    memcpy(input + offset, domain, sizeof(domain));
+    offset += sizeof(domain);
+    memcpy(input + offset, volume_id, NFS4_READ_EVENT_MOUNT_ID_SIZE);
+    offset += NFS4_READ_EVENT_MOUNT_ID_SIZE;
+    input[offset++] = (uint8_t) (inner_fh_len >> 8);
+    input[offset++] = (uint8_t) inner_fh_len;
+    memcpy(input + offset, inner_fh, inner_fh_len);
+    offset += inner_fh_len;
+    return nfs4_read_events_digest(input, offset, digest);
+} /* nfs4_read_events_file_id */
+
+int
+nfs4_read_events_operation_id(
+    const uint8_t session_id[NFS4_READ_EVENT_SESSION_ID_SIZE],
+    uint32_t      slot_id,
+    uint32_t      sequence_id,
+    uint32_t      operation_index,
+    uint8_t       digest[NFS4_READ_EVENT_DIGEST_SIZE])
+{
+    static const char domain[] = "chimera-read-op-v2";
+    uint8_t input[sizeof(domain) + NFS4_READ_EVENT_SESSION_ID_SIZE + 12];
+    size_t  offset = 0;
+
+    memcpy(input + offset, domain, sizeof(domain));
+    offset += sizeof(domain);
+    memcpy(input + offset, session_id, NFS4_READ_EVENT_SESSION_ID_SIZE);
+    offset += NFS4_READ_EVENT_SESSION_ID_SIZE;
+    nfs4_read_events_put_be32(input + offset, slot_id);
+    offset += 4;
+    nfs4_read_events_put_be32(input + offset, sequence_id);
+    offset += 4;
+    nfs4_read_events_put_be32(input + offset, operation_index);
+    offset += 4;
+    return nfs4_read_events_digest(input, offset, digest);
+} /* nfs4_read_events_operation_id */
+
+int
+nfs4_read_events_client_ref(
+    uint64_t client_id,
+    uint8_t  digest[NFS4_READ_EVENT_DIGEST_SIZE])
+{
+    static const char domain[] = "chimera-read-client-v2";
+    uint8_t input[sizeof(domain) + 8];
+
+    memcpy(input, domain, sizeof(domain));
+    for (size_t i = 0; i < 8; i++) {
+        input[sizeof(domain) + i] = (uint8_t) (client_id >> (56 - i * 8));
+    }
+    return nfs4_read_events_digest(input, sizeof(input), digest);
+} /* nfs4_read_events_client_ref */
+
+SYMBOL_EXPORT int
+nfs4_read_events_emit(
+    struct nfs4_read_events      *events,
+    const struct nfs4_read_event *event)
+{
+    struct nfs4_read_queued_event queued = {
+        .event = *event,
+    };
+
+    return nfs4_read_events_enqueue(events, &queued);
+} /* nfs4_read_events_emit */
