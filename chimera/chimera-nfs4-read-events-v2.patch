+    struct prometheus_counter_series   *queue_series;
+    struct prometheus_counter_series   *encode_series;
+    struct prometheus_counter_series   *log_series;
+    struct prometheus_counter_series   *sink_series;
+    struct prometheus_counter_series   *rollback_series;
+    struct prometheus_counter_series   *rotation_series;
+    struct prometheus_counter_instance *queue_instance;
+    struct prometheus_counter_instance *encode_instance;
+    struct prometheus_counter_instance *log_instance;
+    struct prometheus_counter_instance *sink_instance;
+    struct prometheus_counter_instance *rollback_instance;
+    struct prometheus_counter_instance *rotation_instance;
+    struct prometheus_gauge             *state_gauge;
+    struct prometheus_gauge             *producer_info_gauge;
+    struct prometheus_gauge_series      *last_enqueued_series;
+    struct prometheus_gauge_series      *last_synced_series;
+    struct prometheus_gauge_series      *synced_count_series;
+    struct prometheus_gauge_series      *queue_depth_series;
+    struct prometheus_gauge_series      *worker_in_flight_series;
+    struct prometheus_gauge_series      *barrier_ready_series;
+    struct prometheus_gauge_series      *delivery_clean_series;
+    struct prometheus_gauge_instance    *last_enqueued_instance;
+    struct prometheus_gauge_instance    *last_synced_instance;
+    struct prometheus_gauge_instance    *synced_count_instance;
+    struct prometheus_gauge_instance    *queue_depth_instance;
+    struct prometheus_gauge_instance    *worker_in_flight_instance;
+    struct prometheus_gauge_instance    *barrier_ready_instance;
