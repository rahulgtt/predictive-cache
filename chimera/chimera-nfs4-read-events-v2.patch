+#define NFS4_READ_EVENT_QUEUE_SIZE 4096
+#define NFS4_READ_EVENT_SINK_MAX_BYTES (64ULL * 1024 * 1024)
+
+struct nfs4_read_queued_event {
+    uint64_t timestamp_ns;
+    uint64_t sequence;
+    struct nfs4_read_event event;
+};
+
+struct nfs4_read_events {
+    pthread_mutex_t                     lock;
+    pthread_cond_t                      wake;
+    pthread_t                           worker;
+    struct nfs4_read_queued_event       queue[NFS4_READ_EVENT_QUEUE_SIZE];
+    unsigned int                        head;
+    unsigned int                        count;
+    int                                 stopping;
+    int                                 sink_fd;
+    int                                 sink_dir_fd;
+    int                                 sink_enabled;
+    uint64_t                            sink_bytes;
+    uint64_t                            sink_max_bytes;
+    char                                sink_directory[256];
+    char                                sink_name[128];
+    char                                rotated_name[131];
+    ssize_t                             ( *write_fn )(int, const void *, size_t);
+    int                                 ( *fdatasync_fn )(int);
+    int                                 ( *ftruncate_fn )(int, off_t);
+    int                                 ( *fsync_fn )(int);
+    void                                ( *before_enqueue_lock_fn )(
+        const struct nfs4_read_event *);
+    void                                ( *before_barrier_publish_fn )(void);
+    char                                producer_epoch[37];
+    _Atomic uint64_t                    next_sequence;
+    _Atomic uint64_t                    last_enqueued_sequence;
+    _Atomic uint64_t                    last_synced_sequence;
+    _Atomic uint64_t                    synced_count;
+    _Atomic uint64_t                    queue_depth;
+    _Atomic uint64_t                    worker_in_flight;
+    _Atomic uint64_t                    dropped_queue;
+    _Atomic uint64_t                    dropped_encode;
