diff --git a/src/common/tests/log_try_info_test.c b/src/common/tests/log_try_info_test.c
new file mode 100644
index 0000000000000000000000000000000000000000..cd76b3f6897ba994c0673c88d3ec4109963bf2e0
--- /dev/null
+++ b/src/common/tests/log_try_info_test.c
@@ -0,0 +1,70 @@
+// SPDX-FileCopyrightText: 2026 Chimera-NAS Project Contributors
+//
+// SPDX-License-Identifier: LGPL-2.1-only
+
+#define _GNU_SOURCE 1
+
+#undef NDEBUG
+#include <assert.h>
+#include <string.h>
+
+#include "../logging.c"
+
+int
+main(void)
+{
+    static char buffer[CHIMERA_LOG_BUF_SIZE];
+    char        oversized[2049];
+    char       *after_success;
+    char       *event_entry;
+    char       *message_start;
+    char       *message_end;
+
+    ChimeraLogBuf    = buffer;
+    ChimeraLogBufPtr = buffer;
+    assert(chimera_log_try_info("test", "test.c", 1, "value=%d", 42));
+    assert(strstr(buffer, "message=\"value=42\""));
+    after_success = ChimeraLogBufPtr;
+
+    event_entry = after_success;
+    assert(chimera_log_try_info(
+               "nfs", "nfs4_read_events.c", 1,
+               "schema=nfs4_read_v2 local_id=id export_name_b64=dm9sdW1lLTc"
+               " target_fh=AAECAw operation_id=abcd file_size=4096"));
+    message_start = strstr(event_entry, "message=\"");
+    assert(message_start);
+    message_start += strlen("message=\"");
+    message_end = strstr(message_start, "\" process=");
+    assert(message_end);
+    assert(strstr(message_start, "export_name_b64=dm9sdW1lLTc"));
+    assert(strstr(message_start, "target_fh=AAECAw"));
+    assert(strstr(message_end, " level=info module=nfs "));
+    assert(memchr(message_start, '"', (size_t) (message_end - message_start)) == NULL);
+    after_success = ChimeraLogBufPtr;
+
+    pthread_mutex_lock(&ChimeraLogBufLock);
+    assert(!chimera_log_try_info("test", "test.c", 1, "locked"));
+    pthread_mutex_unlock(&ChimeraLogBufLock);
+    assert(ChimeraLogBufPtr == after_success);
+
+    ChimeraLogBufPtr = buffer + sizeof(buffer) - 1;
+    assert(!chimera_log_try_info("test", "test.c", 1, "full"));
+    assert(ChimeraLogBufPtr == buffer + sizeof(buffer) - 1);
+    ChimeraLogBufPtr = after_success;
+
+    memset(oversized, 'x', sizeof(oversized) - 1);
+    oversized[sizeof(oversized) - 1] = '\0';
+    assert(!chimera_log_try_info("test", "test.c", 1, "%s", oversized));
+    assert(ChimeraLogBufPtr == after_success);
+
+    ChimeraLogDisabled = 1;
+    assert(!chimera_log_try_info("test", "test.c", 1, "disabled"));
+    ChimeraLogDisabled = 0;
+    ChimeraLogLevel    = CHIMERA_LOG_ERROR;
+    assert(!chimera_log_try_info("test", "test.c", 1, "filtered"));
+    ChimeraLogLevel  = CHIMERA_LOG_INFO;
+    ChimeraLogBuf    = NULL;
+    ChimeraLogBufPtr = NULL;
+    assert(!chimera_log_try_info("test", "test.c", 1, "uninitialized"));
+    return 0;
+} /* main */
