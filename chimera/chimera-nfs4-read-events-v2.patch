+    _Atomic uint64_t                    dropped_sink;
+    _Atomic uint64_t                    dropped_rollback;
+    _Atomic uint64_t                    dropped_rotation;
+    _Atomic uint64_t                    delivery_clean;
+    uint64_t                            encode_reported;
+    uint64_t                            log_reported;
+    uint64_t                            sink_reported;
+    uint64_t                            rollback_reported;
+    uint64_t                            rotation_reported;
+    struct prometheus_metrics          *metrics;
