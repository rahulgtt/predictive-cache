new file mode 100644
index 0000000000000000000000000000000000000000..d5b66b94c8aa4a5f8e310abe84ede5ae724174a1
--- /dev/null
+++ b/src/server/nfs/tests/test_nfs4_read_decision.c
@@ -0,0 +1,166 @@
+// SPDX-FileCopyrightText: 2026 Chimera-NAS Project Contributors
+//
+// SPDX-License-Identifier: LGPL-2.1-only
+
+#undef NDEBUG
+#include <assert.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "nfs4_procs.h"
+#include "nfs4_compound_cleanup.h"
+
+static unsigned int calls;
+static struct nfs4_read_event captured;
+
+int
+nfs4_read_events_emit(
+    struct nfs4_read_events      *events,
+    const struct nfs4_read_event *event)
+{
+    assert(events);
+    calls++;
+    captured = *event;
+    return 1;
+} /* nfs4_read_events_emit */
+
+void
+chimera_nfs4_compound_process(
+    struct nfs_request *req,
+    nfsstat4            status)
+{
+    (void) req;
+    (void) status;
+    abort();
+} /* chimera_nfs4_compound_process */
+
+struct fixture {
+    struct chimera_server_nfs_shared shared;
+    struct chimera_server_nfs_thread thread;
+    struct nfs_request req;
+    struct COMPOUND4args args;
+    struct nfs_argop4 argops[2];
+    struct nfs_resop4 resops[2];
+};
+
+static void
+fixture_reset(struct fixture *f)
+{
+    memset(&f->req, 0, sizeof(f->req));
+    memset(&f->args, 0, sizeof(f->args));
+    memset(f->argops, 0, sizeof(f->argops));
+    memset(f->resops, 0, sizeof(f->resops));
+    f->thread.active = 1;
+    f->thread.again = 0;
+    f->thread.shared = &f->shared;
+    f->req.thread = &f->thread;
+    f->req.args_compound = &f->args;
+    f->req.res_compound.resarray = f->resops;
+    f->req.res_compound.num_resarray = 2;
+    f->args.argarray = f->argops;
+    f->args.num_argarray = 2;
+} /* fixture_reset */
+
+static void
+complete_read(
+    struct fixture *f,
+    uint32_t        index,
+    uint64_t        offset,
+    uint32_t        requested,
+    uint32_t        returned,
+    nfsstat4        status)
+{
+    f->req.index = index;
+    f->argops[index].argop = OP_READ;
+    f->argops[index].opread.offset = offset;
+    f->argops[index].opread.count = requested;
+    f->resops[index].opread.resok4.data.length = returned;
+    f->req.read_event.offset = offset;
+    f->req.read_event.requested = requested;
+    f->req.read_event_active = true;
+    chimera_nfs4_compound_complete(&f->req, status);
+    assert(!f->req.read_event_active);
+    f->thread.again = 0;
+} /* complete_read */
+
+int
+main(void)
+{
+    struct fixture *f = calloc(1, sizeof(*f));
+
+    assert(f);
+    f->shared.read_events = malloc(1);
+    assert(f->shared.read_events);
+
+    fixture_reset(f);
+    assert(!f->req.read_event_active);
+    f->req.minorversion = 0;
+    f->req.seen_sequence = true;
+    f->req.session = (struct nfs4_session *) 1;
+    chimera_nfs4_read_event_set_active(&f->req, OP_READ);
+    assert(!f->req.read_event_active);
+    f->req.minorversion = 1;
+    f->req.seen_sequence = false;
+    chimera_nfs4_read_event_set_active(&f->req, OP_READ);
+    assert(!f->req.read_event_active);
+    f->req.seen_sequence = true;
+    chimera_nfs4_read_event_set_active(&f->req, OP_GETATTR);
+    assert(!f->req.read_event_active);
+    chimera_nfs4_read_event_set_active(&f->req, OP_READ);
+    assert(f->req.read_event_active);
+    f->req.read_event_active = false;
+    chimera_nfs4_compound_complete(&f->req, NFS4_OK);
+    assert(calls == 0);
+    fixture_reset(f);
+    f->req.read_event.eof = 0;
+    f->req.read_event.file_size = 1000;
+    f->req.read_event.file_size_valid = true;
+    complete_read(f, 0, 1234567890123ULL, 4096, 99, NFS4_OK);
+    assert(calls == 1 && captured.offset == 1234567890123ULL);
+    assert(captured.requested == 4096 && captured.status == NFS4_OK &&
+           captured.bytes == 99);
+    assert(!captured.eof && captured.file_size_valid &&
+           captured.file_size == 1000);
+
+    f->req.read_event.eof = 1;
+    f->req.read_event.file_size = 42;
+    f->req.read_event.file_size_valid = true;
+    complete_read(f, 1, 42, 512, 7, NFS4_OK);
+    assert(calls == 2 && captured.offset == 42);
+    assert(captured.requested == 512 && captured.status == NFS4_OK &&
+           captured.bytes == 7);
+    assert(captured.eof && captured.file_size == 42);
+
+    chimera_nfs4_compound_complete(&f->req, NFS4ERR_REP_TOO_BIG);
+    assert(calls == 2);
+
+    fixture_reset(f);
+    f->req.read_event.eof = 1;
+    complete_read(f, 0, 1000, 4096, 0, NFS4_OK);
+    assert(calls == 3 && captured.bytes == 0 && captured.eof);
+
+    fixture_reset(f);
+    complete_read(f, 0, 9, 64, 17, NFS4ERR_ACCESS);
+    assert(calls == 4 && captured.status == NFS4ERR_ACCESS &&
+           captured.bytes == 0);
+    assert(f->resops[0].opread.status == NFS4ERR_ACCESS);
+    chimera_nfs4_compound_complete(&f->req, NFS4ERR_ACCESS);
+    assert(calls == 4);
+
+    fixture_reset(f);
+    f->argops[0].argop = OP_READ;
+    f->argops[0].opread.offset = 77;
+    f->argops[0].opread.count = 128;
+    f->req.read_event.offset = 77;
+    f->req.read_event.requested = 128;
+    f->req.read_event_active = true;
+    nfs4_reject_undispatched_op(&f->req, &f->argops[0],
+                                &f->resops[0], NFS4ERR_RESOURCE);
+    assert(calls == 5 && captured.offset == 77 && captured.requested == 128);
+    assert(captured.status == NFS4ERR_RESOURCE && captured.bytes == 0);
+    assert(f->resops[0].opread.status == NFS4ERR_RESOURCE);
+
+    free(f->shared.read_events);
+    free(f);
+    return 0;
+} /* main */
