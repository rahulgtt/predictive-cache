+static void
+nfs4_read_event_begin(
+    struct nfs_request    *req,
+    const struct READ4args *args)
+{
+    struct chimera_server_nfs_shared *shared = req->thread->shared;
+    struct nfs4_read_event           *event  = &req->read_event;
+    struct timespec                   now;
+    int     target_len = 0;
+    size_t  tag_len;
+
+    memset(event, 0, sizeof(*event));
+    event->offset    = args->offset;
+    event->requested = args->count;
+    event->compound_op_index = (uint32_t) req->index;
+    event->slot_id            = req->slot_id;
+    event->sequence_id        = req->slot_seqid;
+    if (clock_gettime(CLOCK_REALTIME, &now) == 0) {
+        event->target_created_ns =
+            (uint64_t) now.tv_sec * 1000000000ULL + now.tv_nsec;
+    }
+
+    tag_len = req->args_compound->tag.len;
+    event->compound_tag_original_len = (uint32_t) tag_len;
+    event->compound_tag_len = tag_len > NFS4_READ_EVENT_TAG_SIZE ?
+        NFS4_READ_EVENT_TAG_SIZE : (uint16_t) tag_len;
+    event->compound_tag_truncated = tag_len > NFS4_READ_EVENT_TAG_SIZE;
+    if (event->compound_tag_len) {
+        memcpy(event->compound_tag, req->args_compound->tag.data,
+               event->compound_tag_len);
+    }
+    chimera_nfs_abort_if(
+        !nfs4_read_events_digest(tag_len ?
+                                 req->args_compound->tag.data : "",
+                                 tag_len,
+                                 event->compound_tag_id),
+        "Failed to digest NFSv4 compound tag");
+
+    event->export_id = req->export_id;
+    pthread_mutex_lock(&shared->exports_lock);
+    const struct chimera_nfs_export *export =
+        req->export_id > 0 && req->export_id < CHIMERA_NFS_MAX_EXPORTS ?
+        shared->exports_by_id[req->export_id] : NULL;
+    if (export) {
+        strncpy(event->export_name, export->name,
+                sizeof(event->export_name) - 1);
+    }
+    pthread_mutex_unlock(&shared->exports_lock);
+
+    if (req->session) {
+        event->session_valid = true;
+        chimera_nfs_abort_if(
+            !nfs4_read_events_digest(req->session->nfs4_session_id,
+                                     sizeof(req->session->nfs4_session_id),
