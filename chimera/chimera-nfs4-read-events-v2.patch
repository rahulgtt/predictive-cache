+
+#undef NDEBUG
+#include <assert.h>
+#include <jansson.h>
+#include <sched.h>
+#include <stdarg.h>
+#include <stdatomic.h>
+#include <stdio.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+#include "../nfs_fh_wrap.h"
+#include "../nfs4_read_events.c"
+
+static char                 lines[64][2048];
+static unsigned int         line_count;
+static _Atomic int          reject_log;
+static _Atomic unsigned int rejected;
+static pthread_mutex_t      test_lock    = PTHREAD_MUTEX_INITIALIZER;
+static pthread_cond_t       test_wake    = PTHREAD_COND_INITIALIZER;
+static int                  block_worker = 1;
+static int                  worker_blocked;
+static int                  sync_blocked;
+static int                  sync_entered;
+static int                  sync_fail;
+static int                  partial_write_calls;
+static int                  fsync_calls;
+static int                  fsync_fail_on;
+static int                  first_producer_blocked;
+static int                  release_first_producer;
+static int                  barrier_publish_blocked;
+static int                  barrier_publish_entered;
+
+struct producer_ctx {
+    struct nfs4_read_events *events;
+    struct nfs4_read_event   event;
+};
+
+int
+chimera_log_try_info(
+    const char *mod,
+    const char *file,
+    int         line,
+    const char *fmt,
+    ...)
+{
+    va_list args;
+
+    pthread_mutex_lock(&test_lock);
+    if (block_worker) {
+        worker_blocked = 1;
+        pthread_cond_broadcast(&test_wake);
+        while (block_worker) {
+            pthread_cond_wait(&test_wake, &test_lock);
+        }
+    }
+    pthread_mutex_unlock(&test_lock);
+    if (atomic_load(&reject_log)) {
+        atomic_fetch_add(&rejected, 1);
+        return 0;
+    }
+    assert(line_count < 64);
+    va_start(args, fmt);
+    vsnprintf(lines[line_count++], sizeof(lines[0]), fmt, args);
+    va_end(args);
+    return 1;
+} /* chimera_log_try_info */
+
+static int
+test_fdatasync(int fd)
+{
+    pthread_mutex_lock(&test_lock);
+    if (sync_blocked) {
+        sync_entered = 1;
+        pthread_cond_broadcast(&test_wake);
+        while (sync_blocked) {
+            pthread_cond_wait(&test_wake, &test_lock);
+        }
+    }
+    pthread_mutex_unlock(&test_lock);
+    if (sync_fail) {
+        errno = EIO;
+        return -1;
+    }
+    return fdatasync(fd);
+} /* test_fdatasync */
+
+static ssize_t
+test_partial_write(
+    int         fd,
+    const void *buffer,
+    size_t      length)
+{
+    if (partial_write_calls++ == 0) {
+        return write(fd, buffer, length / 2);
+    }
+    errno = EIO;
+    return -1;
+} /* test_partial_write */
+
+static int
+test_ftruncate_fail(
+    int   fd,
+    off_t length)
+{
+    (void) fd;
+    (void) length;
+    errno = EIO;
+    return -1;
+} /* test_ftruncate_fail */
+
+static int
+test_fsync_fail(int fd)
+{
+    (void) fd;
+    errno = EIO;
+    return -1;
+} /* test_fsync_fail */
+
+static int
+test_fsync_nth(int fd)
+{
+    if (++fsync_calls == fsync_fail_on) {
+        errno = EIO;
+        return -1;
+    }
+    return fsync(fd);
+} /* test_fsync_nth */
+
+static void *
+test_producer(void *arg)
+{
+    struct producer_ctx *ctx = arg;
+
+    while (!nfs4_read_events_emit(ctx->events, &ctx->event)) {
+        sched_yield();
+    }
+    return NULL;
+} /* test_producer */
+
+static void
+test_reorder_before_lock(const struct nfs4_read_event *event)
+{
+    if (event->offset != 0) {
+        return;
+    }
+    pthread_mutex_lock(&test_lock);
+    first_producer_blocked = 1;
+    pthread_cond_broadcast(&test_wake);
+    while (!release_first_producer) {
+        pthread_cond_wait(&test_wake, &test_lock);
+    }
+    pthread_mutex_unlock(&test_lock);
+} /* test_reorder_before_lock */
+
+static void
+test_before_barrier_publish(void)
+{
+    pthread_mutex_lock(&test_lock);
+    barrier_publish_entered = 1;
+    pthread_cond_broadcast(&test_wake);
+    while (barrier_publish_blocked) {
+        pthread_cond_wait(&test_wake, &test_lock);
+    }
+    pthread_mutex_unlock(&test_lock);
+} /* test_before_barrier_publish */
+
+static void
+emit_without_queue_drop(
+    struct nfs4_read_events      *events,
+    const struct nfs4_read_event *event)
+{
+    for (unsigned int attempt = 0; attempt < 10000; attempt++) {
+        if (nfs4_read_events_emit(events, event)) {
+            return;
+        }
+        sched_yield();
+    }
+    assert(0 && "could not enqueue a READ decision event");
+} /* emit_without_queue_drop */
+
+static void
+wait_for_worker(void)
+{
+    pthread_mutex_lock(&test_lock);
+    while (!worker_blocked) {
+        pthread_cond_wait(&test_wake, &test_lock);
+    }
+    pthread_mutex_unlock(&test_lock);
+} /* wait_for_worker */
+
+static void
+release_worker(void)
+{
+    pthread_mutex_lock(&test_lock);
+    block_worker = 0;
+    pthread_cond_broadcast(&test_wake);
+    pthread_mutex_unlock(&test_lock);
+} /* release_worker */
+
+static void
+make_sink_path(char path[64])
+{
+    int fd;
+
+    strcpy(path, "/tmp/chimera-read-events-XXXXXX");
+    fd = mkstemp(path);
+    assert(fd >= 0);
+    close(fd);
+    unlink(path);
+} /* make_sink_path */
+
+static unsigned int
+sink_line_count(const char *path)
+{
+    FILE        *file = fopen(path, "r");
+    char         line[4096];
+    unsigned int count = 0;
+
+    if (!file) {
+        return 0;
+    }
+    while (fgets(line, sizeof(line), file)) {
+        json_error_t error;
+        json_t      *record = json_loads(line, 0, &error);
+        const char  *event_time;
+        const char  *sink_time;
+
+        if (!record) {
+            fprintf(stderr, "invalid JSONL at %d:%d: %s\n%s",
+                    error.line, error.column, error.text, line);
+        }
+        assert(record);
+        assert(strcmp(json_string_value(json_object_get(record, "schema")),
+                      "nfs4_read_v2") == 0);
+        event_time = json_string_value(
+            json_object_get(record, "event_time_ns"));
+        sink_time = json_string_value(
+            json_object_get(record, "sink_time_ns"));
+        assert(event_time && sink_time);
+        assert(strtoull(sink_time, NULL, 10) >=
+               strtoull(event_time, NULL, 10));
+        json_decref(record);
+        count++;
+    }
+    fclose(file);
+    return count;
+} /* sink_line_count */
+
+static unsigned int
+sink_match_count(
+    const char *path,
+    const char *needle)
+{
+    FILE        *file = fopen(path, "r");
+    char         line[4096];
+    unsigned int count = 0;
+
+    assert(file);
+    while (fgets(line, sizeof(line), file)) {
+        if (strstr(line, needle)) {
+            count++;
+        }
+    }
+    fclose(file);
+    return count;
+} /* sink_match_count */
+
+static void
+assert_sink_sequences(
+    const char   *path,
+    unsigned int  expected)
+{
+    FILE        *file = fopen(path, "r");
+    char         line[4096];
+    unsigned int sequence = 0;
+
+    assert(file);
+    while (fgets(line, sizeof(line), file)) {
+        json_error_t error;
+        json_t      *record = json_loads(line, 0, &error);
+        const char  *value;
+
+        assert(record);
+        value = json_string_value(
+            json_object_get(record, "producer_sequence"));
+        assert(value);
+        assert(strtoull(value, NULL, 10) == ++sequence);
+        json_decref(record);
+    }
+    fclose(file);
+    assert(sequence == expected);
+} /* assert_sink_sequences */
+
+static void
+sink_first_epoch(
+    const char *path,
+    char        epoch[37])
+{
+    FILE         *file = fopen(path, "r");
+    char          line[4096];
+    json_error_t  error;
+    json_t       *record;
+    const char   *value;
+
+    assert(file);
+    assert(fgets(line, sizeof(line), file));
+    fclose(file);
+    record = json_loads(line, 0, &error);
+    assert(record);
+    value = json_string_value(json_object_get(record, "producer_epoch"));
+    assert(value && strlen(value) == 36);
+    memcpy(epoch, value, 37);
+    json_decref(record);
+} /* sink_first_epoch */
+
+static void
+test_identity_vectors(void)
+{
+    uint8_t volume[16], inner[16], session[16];
+    uint8_t file_id[32], operation_id[32], session_ref[32], client_ref[32];
+    uint8_t key1[16] = { 1 }, key2[16] = { 2 };
+    uint8_t wire1[CHIMERA_NFS_FH_MAX], wire2[CHIMERA_NFS_FH_MAX];
+    uint8_t decoded[CHIMERA_VFS_FH_SIZE], zero_digest[32];
+    uint16_t export_id;
+    int wire1_len, wire2_len, decoded_len;
+    char hex[65];
+
+    for (size_t i = 0; i < sizeof(volume); i++) {
+        volume[i] = (uint8_t) i;
+        inner[i]  = (uint8_t) (i + 16);
+        session[i] = (uint8_t) i;
+    }
+    assert(nfs4_read_events_file_id(volume, inner, sizeof(inner), file_id));
+    nfs4_read_events_hex(file_id, sizeof(file_id), hex);
+    assert(strcmp(hex,
+                  "336a5c3da93d04dab989509a4eb5c2f147a2cd4b0ff3098c"
+                  "3499e9f0f0a6921b") == 0);
+    assert(nfs4_read_events_operation_id(session, 4, 5, 3, operation_id));
+    nfs4_read_events_hex(operation_id, sizeof(operation_id), hex);
+    assert(strcmp(hex,
+                  "ccbf74fb9770465efae264496ca0a03a272f78e792194a9b"
+                  "41dcd042bcf1412c") == 0);
+    assert(nfs4_read_events_digest(session, sizeof(session), session_ref));
+    nfs4_read_events_hex(session_ref, sizeof(session_ref), hex);
+    assert(strcmp(hex,
+                  "be45cb2605bf36bebde684841a28f0fd43c69850a3dce5f"
+                  "edba69928ee3a8991") == 0);
+    assert(nfs4_read_events_client_ref(99, client_ref));
+    nfs4_read_events_hex(client_ref, sizeof(client_ref), hex);
+    assert(strcmp(hex,
+                  "b45232b489aed72eac1e713b4f1545827f7e91a2d98e709"
+                  "f4787aec66899a0cc") == 0);
+
+    assert(nfs4_read_events_file_id(volume, inner, 0, zero_digest));
+    assert(!nfs4_read_events_file_id(volume, inner,
+                                     NFS4_READ_EVENT_TARGET_FH_SIZE + 1,
+                                     zero_digest));
+
+    assert(chimera_nfs_fh_wrap(wire1, &wire1_len, 7, inner, sizeof(inner),
+                               key1, 1) == CHIMERA_NFS_FH_OK);
+    assert(chimera_nfs_fh_wrap(wire2, &wire2_len, 7, inner, sizeof(inner),
+                               key2, 1) == CHIMERA_NFS_FH_OK);
+    assert(wire1_len == wire2_len);
+    assert(memcmp(wire1, wire2, wire1_len) != 0);
+    assert(chimera_nfs_fh_unwrap(wire1, wire1_len, &export_id,
+                                 decoded, &decoded_len, key1, 1) ==
+           CHIMERA_NFS_FH_OK);
+    assert(export_id == 7 && decoded_len == (int) sizeof(inner));
+    assert(memcmp(decoded, inner, sizeof(inner)) == 0);
+    assert(chimera_nfs_fh_unwrap(wire2, wire2_len, &export_id,
+                                 decoded, &decoded_len, key2, 1) ==
+           CHIMERA_NFS_FH_OK);
+    assert(memcmp(decoded, inner, sizeof(inner)) == 0);
+    assert(nfs4_read_events_file_id(volume, decoded, (uint16_t) decoded_len,
+                                    zero_digest));
+    assert(memcmp(file_id, zero_digest, sizeof(file_id)) == 0);
+} /* test_identity_vectors */
+
+int
+main(void)
+{
+    struct prometheus_metrics *metrics = prometheus_metrics_create(NULL, NULL, 0);
+    struct nfs4_read_events   *events;
+    struct nfs4_read_event     event = { 0 };
+    char                       id1[37], id2[37];
+    char                       sink_path[64];
+    char                       first_epoch[37], next_epoch[37];
+    char                       metrics_buffer[8192];
+
+    test_identity_vectors();
+    assert(metrics);
+    event.offset          = UINT64_MAX;
+    event.requested       = UINT32_MAX;
+    event.bytes           = 7;
+    event.eof             = 1;
+    event.file_size       = UINT64_MAX;
+    event.file_size_valid = true;
+    event.identity_valid  = true;
+    event.export_id       = 7;
+    event.session_valid   = true;
+    event.compound_op_index = 3;
+    event.slot_id           = 4;
+    event.sequence_id       = 5;
+    event.target_created_ns = 1234;
+    event.target_fh_len   = sizeof(event.target_fh);
+    strcpy(event.export_name, "volume-7");
+    strcpy(event.compound_tag,
+           "pc1:d:0123456789abcdef0123456789abcdef:"
+           "11111111111111111111111111111111:"
+           "22222222222222222222222222222222");
+    event.compound_tag_len = strlen(event.compound_tag);
+    event.compound_tag_original_len = event.compound_tag_len;
+    assert(event.compound_tag_len == 104);
+    for (size_t i = 0; i < sizeof(event.volume_id); i++) {
+        event.volume_id[i] = (uint8_t) i;
+    }
+    for (size_t i = 0; i < sizeof(event.file_id); i++) {
+        event.file_id[i] = (uint8_t) (i + 1);
+        event.operation_id[i] = (uint8_t) (0x20 + i);
+        event.client_ref[i] = (uint8_t) (0x40 + i);
+        event.session_ref[i] = (uint8_t) (0x60 + i);
+        event.compound_tag_id[i] = (uint8_t) (0xff - i);
+    }
+    for (size_t i = 0; i < sizeof(event.target_fh); i++) {
+        event.target_fh[i] = (uint8_t) i;
+    }
+
+    make_sink_path(sink_path);
+    events = nfs4_read_events_create(metrics, sink_path);
+    memcpy(first_epoch, events->producer_epoch, sizeof(first_epoch));
+    assert(prometheus_metrics_scrape(metrics, metrics_buffer,
+                                     sizeof(metrics_buffer)) > 0);
+    assert(strstr(metrics_buffer, first_epoch));
+    struct stat sink_stat;
+    assert(stat(sink_path, &sink_stat) == 0);
+    assert((sink_stat.st_mode & 0777) == 0600);
+    emit_without_queue_drop(events, &event);
+    wait_for_worker();
+    event.offset          = 42;
+    event.requested       = 4096;
+    event.status          = 13;
+    event.bytes           = 0;
+    event.file_size_valid = false;
+    memset(event.compound_tag, 'x', NFS4_READ_EVENT_TAG_SIZE);
+    event.compound_tag[NFS4_READ_EVENT_TAG_SIZE] = '\0';
+    event.compound_tag_len = NFS4_READ_EVENT_TAG_SIZE;
+    event.compound_tag_original_len = 4096;
+    event.compound_tag_truncated = true;
+    event.operation_id[0] = 0x99;
+    emit_without_queue_drop(events, &event);
+    event.offset = 43;
+    event.compound_tag[0] = '\0';
+    event.compound_tag_len = 0;
+    event.compound_tag_original_len = 0;
+    event.compound_tag_truncated = false;
+    emit_without_queue_drop(events, &event);
+    release_worker();
+    for (unsigned int attempt = 0; attempt < 10000; attempt++) {
+        if (sink_line_count(sink_path) == 3) {
+            break;
+        }
+        sched_yield();
+    }
+    assert(sink_line_count(sink_path) == 3);
+    assert(sink_match_count(
+               sink_path,
+               "\"operation_id\":\"202122232425262728292a2b2c2d2e2f"
+               "303132333435363738393a3b3c3d3e3f\"") == 1);
+    sink_first_epoch(sink_path, next_epoch);
+    assert(strcmp(first_epoch, next_epoch) == 0);
+    assert(atomic_load(&events->dropped_queue) == 0);
+    assert(atomic_load(&events->dropped_encode) == 0);
+    assert(atomic_load(&events->dropped_sink) == 0);
+    nfs4_read_events_destroy(events);
+    unlink(sink_path);
+
+    assert(line_count == 3);
+    assert(strstr(lines[0], "schema=nfs4_read_v2 local_id="));
+    assert(strstr(lines[0], "producer_epoch="));
+    assert(strstr(lines[0], "producer_sequence=1 event_time_ns="));
+    assert(strstr(lines[0], "target_created_ns=1234"));
+    assert(strstr(lines[0],
+                  "volume_id=000102030405060708090a0b0c0d0e0f"));
+    assert(strstr(lines[0],
+                  "file_id=0102030405060708090a0b0c0d0e0f10"
+                  "1112131415161718191a1b1c1d1e1f20"));
+    assert(strstr(lines[0], "export_name_b64=dm9sdW1lLTc export_id=7"));
+    assert(strstr(lines[0], "target_fh=AAECAwQFBgcICQoLDA0ODx"));
+    assert(strstr(lines[0],
+                  "operation_id=202122232425262728292a2b2c2d2e2f"
+                  "303132333435363738393a3b3c3d3e3f"));
+    assert(strstr(lines[0],
+                  "client_ref=404142434445464748494a4b4c4d4e4f"
+                  "505152535455565758595a5b5c5d5e5f"));
+    assert(strstr(lines[0],
+                  "session_ref=606162636465666768696a6b6c6d6e6f"
+                  "707172737475767778797a7b7c7d7e7f"));
+    assert(strstr(lines[0],
+                  "compound_op_index=3 slot_id=4 sequence_id=5"));
+    assert(strstr(lines[0],
+                  "origin_claim=controlled_demand"
+                  " origin_trust=client_asserted"));
+    assert(strstr(lines[0],
+                  "requested_offset=18446744073709551615"
+                  " requested_count=4294967295 returned_bytes=7"
+                  " nfs_status=0 outcome=success eof=true"
+                  " file_size_valid=true file_size=18446744073709551615"));
+    assert(strstr(lines[1],
+                  "producer_sequence=2"));
+    assert(strstr(lines[1],
+                  "compound_tag_b64=eHh4eHh4eHh4"));
+    assert(strstr(lines[1],
+                  "compound_tag_original_length=4096"
+                  " compound_tag_truncated=true"));
+    assert(strstr(lines[1],
+                  "origin_claim=unknown origin_trust=client_asserted"));
+    assert(strstr(lines[1],
+                  "requested_offset=42 requested_count=4096"
+                  " returned_bytes=0 nfs_status=13 outcome=error"
+                  " eof=false file_size_valid=false file_size=unknown"));
+    assert(sscanf(lines[0], "schema=nfs4_read_v2 local_id=%36s", id1) == 1);
+    assert(sscanf(lines[1], "schema=nfs4_read_v2 local_id=%36s", id2) == 1);
+    assert(strcmp(id1, id2) != 0);
+    assert(strstr(lines[2], "compound_tag_b64="));
+    assert(strstr(lines[2], " compound_tag_original_length=0"));
+    assert(strstr(lines[2], "origin_claim=unknown origin_trust=client_asserted"));
+
+    make_sink_path(sink_path);
+    events = nfs4_read_events_create(metrics, sink_path);
+    memcpy(next_epoch, events->producer_epoch, sizeof(next_epoch));
+    assert(strcmp(first_epoch, next_epoch) != 0);
+    assert(prometheus_metrics_scrape(metrics, metrics_buffer,
+                                     sizeof(metrics_buffer)) > 0);
+    assert(strstr(metrics_buffer, next_epoch));
+    pthread_mutex_lock(&events->lock);
+    nfs4_read_events_emit(events, &event);
+    assert(atomic_load(&events->dropped_queue) == 1);
+    assert(events->barrier_ready_instance->value == 0);
+    assert(prometheus_metrics_scrape(metrics, metrics_buffer,
+                                     sizeof(metrics_buffer)) > 0);
+    assert(strstr(metrics_buffer,
+                  "chimera_nfs4_read_events_dropped{stage=\"queue\"} 1"));
+    assert(strstr(metrics_buffer,
+                  "chimera_nfs4_read_event_state{state=\"barrier_ready\"} 0"));
+    pthread_mutex_unlock(&events->lock);
+    nfs4_read_events_destroy(events);
+    unlink(sink_path);
+
+    atomic_store(&reject_log, 1);
+    pthread_mutex_lock(&test_lock);
+    block_worker   = 1;
+    worker_blocked = 0;
+    pthread_mutex_unlock(&test_lock);
+    events = nfs4_read_events_create(metrics, sink_path);
+    emit_without_queue_drop(events, &event);
+    wait_for_worker();
+    release_worker();
+    nfs4_read_events_destroy(events);
+    assert(atomic_load(&rejected) == 1);
+    assert(sink_line_count(sink_path) == 1);
+    unlink(sink_path);
+
+    atomic_store(&rejected, 0);
+    pthread_mutex_lock(&test_lock);
+    block_worker   = 1;
+    worker_blocked = 0;
+    pthread_mutex_unlock(&test_lock);
+    events = nfs4_read_events_create(metrics, NULL);
+    emit_without_queue_drop(events, &event);
+    wait_for_worker();
+    for (unsigned int i = 0; i < NFS4_READ_EVENT_QUEUE_SIZE; i++) {
+        event.offset = i;
+        emit_without_queue_drop(events, &event);
+    }
+    nfs4_read_events_emit(events, &event);
+    assert(atomic_load(&events->dropped_queue) == 1);
+    release_worker();
+    nfs4_read_events_destroy(events);
+    assert(atomic_load(&rejected) == NFS4_READ_EVENT_QUEUE_SIZE + 1);
+
+    atomic_store(&reject_log, 0);
+    make_sink_path(sink_path);
+    events = nfs4_read_events_create(metrics, sink_path);
+    event.target_fh_len = NFS4_READ_EVENT_TARGET_FH_SIZE + 1;
+    emit_without_queue_drop(events, &event);
+    release_worker();
+    uint64_t encode_drops;
+    for (unsigned int attempt = 0; attempt < 10000; attempt++) {
+        encode_drops = atomic_load(&events->dropped_encode);
